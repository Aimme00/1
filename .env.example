# 大模型。默认使用 DeepSeek；真实密钥只放在本地/服务器环境变量中，不要提交 .env。
ASKDATA_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_COT_MODEL=deepseek-v4-flash
DEEPSEEK_CODER_MODEL=deepseek-v4-flash
# 本地可使用确定性 Mock；production 默认禁止 Mock，避免输出伪造结果。
ASKDATA_ALLOW_MOCK_MODEL=true

# 如需切回阿里云百炼，将 ASKDATA_LLM_PROVIDER 改为 dashscope。
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_COT_MODEL=qwen-plus
DASHSCOPE_CODER_MODEL=qwen-plus

# 数据源。默认使用内置 SQLite；切换 mysql 后启动时自动同步 Schema。
ASKDATA_DATABASE_TYPE=sqlite
ASKDATA_DATABASE_ALIAS=trade_db
ASKDATA_ENFORCE_READONLY=true
ASKDATA_REQUIRE_SQLGLOT=true
# 默认不读取业务样例值，避免敏感数据进入 Schema Prompt。范围 0-10。
ASKDATA_SCHEMA_SAMPLE_SIZE=0
# 可选：表/字段中文释义、别名和语义角色 JSON。
ASKDATA_BUSINESS_META_PATH=

# MySQL 业务库必须使用只读账号。
ASKDATA_MYSQL_HOST=127.0.0.1
ASKDATA_MYSQL_PORT=3306
ASKDATA_MYSQL_USER=askdata_readonly
ASKDATA_MYSQL_PASSWORD=
ASKDATA_MYSQL_DATABASE=analytics
ASKDATA_MYSQL_CONNECT_TIMEOUT=10
ASKDATA_MYSQL_READ_TIMEOUT=30
ASKDATA_MYSQL_MAX_EXECUTION_TIME_MS=30000
ASKDATA_MYSQL_MAX_ROWS=5000

# Web 服务。云部署时通常使用 0.0.0.0。
ASKDATA_HOST=127.0.0.1
ASKDATA_PORT=8000
ASKDATA_RUNTIME_DIR=runtime_data
ASKDATA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 登录鉴权。本地 development 模式有演示账号；production 必须显式设置。
ASKDATA_ENV=development
ASKDATA_BOOTSTRAP_EMAIL=demo@askdata.local
ASKDATA_BOOTSTRAP_PASSWORD=askdata-demo
ASKDATA_BOOTSTRAP_DISPLAY_NAME=Demo Analyst
ASKDATA_SESSION_TTL_SECONDS=86400
# HTTPS 部署时必须为 true。
ASKDATA_COOKIE_SECURE=false

# 公开面试 Demo：每个访客网络最多提问 2 次；测试码用户不限次数。
ASKDATA_GUEST_QUERY_LIMIT=2
# 生产环境应使用随机长字符串；Render Blueprint 会自动生成。
ASKDATA_QUOTA_SALT=askdata-local-quota
ASKDATA_TEST_TOKEN=
# Vercel + Neon PostgreSQL（长期公网完整 Agent）
# ASKDATA_DATABASE_TYPE=postgres
# ASKDATA_POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# ASKDATA_SESSION_SECRET=请填写至少32位随机字符串
